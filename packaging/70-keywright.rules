# Let the logged-in user talk to Keychron keyboards and the 2.4G receiver over raw HID.
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3434", TAG+="uaccess", MODE="0660"
# STM32 bootloader, for flashing the wireless-config firmware.
SUBSYSTEM=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="df11", TAG+="uaccess", MODE="0660"
